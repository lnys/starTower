{
  "name": "mota-tower",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "星穹塔 · 50 层原创魔塔冒险",
  "scripts": {
    "images": "node scripts/generate-images.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/star-engine.mjs && node tests/star-rules.mjs && node tools/star-verify.mjs && node tests/star-replay.mjs && node --test tests/star-ui.mjs",
    "test:simulate": "node tests/star-playthrough.mjs",
    "test:no-altar": "NO_ALTAR=1 node tests/star-playthrough.mjs",
    "test:double-keys": "DOUBLE_KEYS=1 node tests/star-playthrough.mjs",
    "desktop": "npm run build && electron .",
    "desktop:test": "npm run build && electron . --smoke-test",
    "dist:mac": "npm run build && electron-builder --mac --universal",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "main": "electron/main.cjs",
  "author": "Star Dome Tower",
  "build": {
    "appId": "cn.fastmini.stardometower",
    "productName": "星穹塔",
    "copyright": "Copyright © 2026 Star Dome Tower",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/index.html",
      "electron/main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.role-playing-games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "星穹塔 安装",
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 440,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "StarDomeTower-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "星穹塔"
    },
    "portable": {
      "artifactName": "StarDomeTower-${version}-windows-${arch}-portable.${ext}"
    },
    "artifactName": "StarDomeTower-${version}-${os}-${arch}.${ext}"
  }
}
